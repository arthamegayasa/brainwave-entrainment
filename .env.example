# Copy to .env.local and fill in. All three are browser-safe public keys.
# The Midtrans SERVER key is a secret and must NOT go here — store it only in
# Supabase (app_config table / production: Vault or edge-function secrets).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxx
