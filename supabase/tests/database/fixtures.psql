-- Fixture for the pgTAP suite. Include it right after `begin;` in every test
-- file with `\ir fixtures.psql`; everything it creates lives in that test's
-- transaction and disappears on `rollback`. Keep test files in this folder:
-- `supabase test db <file>` mounts only the file's own folder. The `.psql`
-- extension keeps `supabase test db` from running this file as a test.
--
-- Tests refer to Users by a label that is unique within one test file (a
-- fixture label only, not a Username):
--   select tests.create_user('clinician_a', 'clinician');
--   select tests.create_user('patient_a');
--   select tests.link('clinician_a', 'patient_a');
--   select tests.act_as('clinician_a');   -- or tests.act_as_anon()
--   reset role;                           -- back to the fixture owner

create schema tests;

-- The test User's email, derived from its label.
create function tests.email(p_label text)
returns text
language sql
immutable
as $$
  select p_label || '@serenade.test';
$$;

-- The User's id; raises for an unknown label so a typo cannot turn a
-- "sees nothing" assertion into a vacuous pass. security definer: tests call
-- it while acting as anon or authenticated, which cannot read auth.users.
create function tests.user_id(p_label text)
returns uuid
language plpgsql
stable
security definer
set search_path = ''
as $$
declare
  v_id uuid;
begin
  select id into v_id from auth.users where email = tests.email(p_label);
  if not found then
    raise exception 'tests.user_id: no User labelled %', p_label;
  end if;
  return v_id;
end;
$$;

-- Creates a User (auth.users row + profile) with a role: 'user' (a Regular,
-- or a Patient once linked), 'clinician' or 'admin'. Returns the User's id.
create function tests.create_user(p_label text, p_role text default 'user')
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, email, aud, role)
  values (v_id, tests.email(p_label), 'authenticated', 'authenticated');

  -- The signup trigger normally creates the profile; upsert so the role holds
  -- whatever that trigger does.
  insert into public.profiles (user_id, email, role)
  values (v_id, tests.email(p_label), p_role)
  on conflict (user_id) do update set role = excluded.role;

  return v_id;
end;
$$;

-- Creates the Link between a Clinician and a Patient.
create function tests.link(p_clinician text, p_patient text)
returns void
language sql
as $$
  insert into public.patient_links (clinician_id, patient_id)
  values (tests.user_id(p_clinician), tests.user_id(p_patient));
$$;

-- Acts as a signed-in User for the rest of the transaction: the authenticated
-- role with the JWT claims PostgREST would set, so auth.uid() is that User.
create function tests.act_as(p_label text)
returns void
language plpgsql
as $$
declare
  v_id uuid := tests.user_id(p_label);
begin
  perform set_config('role', 'authenticated', true);
  perform set_config(
    'request.jwt.claims',
    json_build_object(
      'sub', v_id,
      'role', 'authenticated',
      'email', tests.email(p_label)
    )::text,
    true
  );
end;
$$;

-- Acts as a signed-out visitor (the anon key) for the rest of the transaction.
create function tests.act_as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
end;
$$;

-- Tests switch identity and look Users up while acting as anon/authenticated.
grant usage on schema tests to anon, authenticated;
grant execute on all functions in schema tests to anon, authenticated;
