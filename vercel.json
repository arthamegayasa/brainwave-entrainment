{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sessions", "destination": "/index.html" },
    { "source": "/library", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/science", "destination": "/index.html" },
    { "source": "/premium", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/p/:path*", "destination": "/index.html" }
  ]
}
